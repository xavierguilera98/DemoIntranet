# Adreça on escolta Ollama. Dins Docker Compose el servei es diu "ollama";
# en local sol ser localhost.
OLLAMA_BASE_URL=http://ollama:11434

# Model de xat (petit, pensat per córrer sense GPU dedicada)
CHAT_MODEL=llama3.2:1b

# Model d'embeddings per al RAG
EMBEDDING_MODEL=nomic-embed-text

# On es guarda la base de dades vectorial (Chroma)
CHROMA_PERSIST_DIR=/data/chroma_db
